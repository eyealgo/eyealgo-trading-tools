// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © EyeAlgo
// HalfTrend calculation is based on the open-source "HalfTrend" indicator by everget (MPL 2.0). Thank you.
// Added by Eye Algo: 200 EMA trend filter, SL types, Risk:Reward TP, partial close, break-even, ATR trailing, % risk sizing.

//@version=6
strategy("HalfTrend + EMA Trend Filter Strategy [Eye Algo]", shorttitle="HalfTrend EMA Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, process_orders_on_close=true)

// ═══════════════════════════════════════════════════════════════
//  HALFTREND
// ═══════════════════════════════════════════════════════════════
G_H = "HalfTrend"
amplitude = input.int(2, "Amplitude", minval=1, group=G_H)

G_F = "Trend filter"
useEma = input.bool(true, "Trade only in EMA direction", group=G_F)
emaLen = input.int(200, "EMA length", minval=1, group=G_F)
showFiltered = input.bool(true, "Mark filtered signals", group=G_F)

G_SL = "Stop loss"
slType   = input.string("ATR", "Stop loss type", options=["ATR", "Fixed ticks", "Percent", "HalfTrend line"], group=G_SL)
slAtrLen = input.int(14, "ATR length", minval=1, group=G_SL)
slAtrMul = input.float(1.5, "ATR multiplier", minval=0.1, step=0.1, group=G_SL)
slTicks  = input.int(300, "Fixed stop (ticks)", minval=1, group=G_SL)
slPct    = input.float(1.0, "Stop (%)", minval=0.01, step=0.1, group=G_SL)
closeOpp = input.bool(true, "Close on opposite HalfTrend signal", group=G_SL)

var int   trend        = 0
var int   nextTrend    = 0
var float maxLowPrice  = low
var float minHighPrice = high
var float up   = 0.0
var float down = 0.0

atr2      = nz(ta.atr(100)) / 2
highPrice = high[math.abs(nz(ta.highestbars(amplitude)))]
lowPrice  = low[math.abs(nz(ta.lowestbars(amplitude)))]
highma    = ta.sma(high, amplitude)
lowma     = ta.sma(low, amplitude)

if nextTrend == 1
    maxLowPrice := math.max(lowPrice, maxLowPrice)
    if highma < maxLowPrice and close < nz(low[1], low)
        trend := 1
        nextTrend := 0
        minHighPrice := highPrice
else
    minHighPrice := math.min(highPrice, minHighPrice)
    if lowma > minHighPrice and close > nz(high[1], high)
        trend := 0
        nextTrend := 1
        maxLowPrice := lowPrice

if trend == 0
    if nz(trend[1]) != 0
        up := nz(down[1], down)
    else
        up := bar_index == 0 ? maxLowPrice : math.max(maxLowPrice, nz(up[1], maxLowPrice))
else
    if nz(trend[1]) != 1
        down := nz(up[1], up)
    else
        down := math.min(minHighPrice, nz(down[1], minHighPrice))

ht      = trend == 0 ? up : down
htColor = trend == 0 ? color.new(#22b07d, 0) : color.new(#e5484d, 0)
plot(ht, "HalfTrend", color=htColor, linewidth=2)

buyRaw  = trend == 0 and nz(trend[1]) == 1
sellRaw = trend == 1 and nz(trend[1]) == 0

ema = ta.ema(close, emaLen)
plot(useEma ? ema : na, "EMA", color=color.new(#c9ced6, 30), linewidth=1)

longOk  = not useEma or close > ema
shortOk = not useEma or close < ema

plotshape(buyRaw and longOk, "Buy", shape.labelup, location.belowbar, color.new(#22b07d, 0), text="BUY", textcolor=color.white, size=size.small)
plotshape(sellRaw and shortOk, "Sell", shape.labeldown, location.abovebar, color.new(#e5484d, 0), text="SELL", textcolor=color.white, size=size.small)
plotshape(showFiltered and buyRaw and not longOk, "Filtered buy", shape.xcross, location.belowbar, color.new(color.gray, 30), size=size.tiny)
plotshape(showFiltered and sellRaw and not shortOk, "Filtered sell", shape.xcross, location.abovebar, color.new(color.gray, 30), size=size.tiny)

// ═══════════════════════════════════════════════════════════════
//  HOOKS FOR THE TRADE ENGINE
// ═══════════════════════════════════════════════════════════════
slAtr    = ta.atr(slAtrLen)
baseDist = slType == "ATR" ? slAtr * slAtrMul : slType == "Fixed ticks" ? slTicks * syminfo.mintick : close * slPct / 100
longSig      = buyRaw and longOk
shortSig     = sellRaw and shortOk
exitLongSig  = closeOpp and sellRaw
exitShortSig = closeOpp and buyRaw
exitTag      = "Opposite signal"
float slLongPrice  = slType == "HalfTrend line" ? ht - atr2 : close - baseDist
float slShortPrice = slType == "HalfTrend line" ? ht + atr2 : close + baseDist
float tpLongPrice  = na
float tpShortPrice = na
bool  noTP         = false
entryTagL = "HT Buy"
entryTagS = "HT Sell"
float trailLongPrice  = na
float trailShortPrice = na

// ═══════════════════════════════════════════════════════════════
//  TRADE MANAGEMENT  (shared Eye Algo engine)
// ═══════════════════════════════════════════════════════════════
G_TM = "Trade management"
tradeDir  = input.string("Both", "Trade direction", options=["Both", "Long only", "Short only"], group=G_TM)
rr        = input.float(2.0, "Take profit (Risk:Reward)", minval=0.1, step=0.1, group=G_TM)
usePart   = input.bool(true, "Partial close at 1R", group=G_TM)
partPct   = input.int(50, "Partial close (%)", minval=1, maxval=99, group=G_TM)
useBE     = input.bool(true, "Move stop to break-even after partial", group=G_TM)
useTrail  = input.bool(false, "ATR trailing stop", group=G_TM)
trailLen  = input.int(14, "Trailing ATR length", minval=1, group=G_TM)
trailMult = input.float(2.0, "Trailing ATR multiplier", minval=0.1, step=0.1, group=G_TM)

G_PS = "Position size"
sizeMode  = input.string("Fixed quantity", "Size mode", options=["Fixed quantity", "% risk of equity"], group=G_PS)
fixedQty  = input.float(1.0, "Fixed quantity", minval=0.000001, group=G_PS)
riskPct   = input.float(1.0, "Risk per trade (%)", minval=0.01, step=0.1, group=G_PS)

G_VIS = "Visuals"
showLvls  = input.bool(true, "Show entry / SL / TP lines", group=G_VIS)

trailAtr = ta.atr(trailLen)

calcQty(float dist) =>
    float q = sizeMode == "Fixed quantity" or dist <= 0 ? fixedQty : strategy.equity * riskPct / 100.0 / (dist * syminfo.pointvalue)
    math.max(q, 0.0)

var float ep  = na
var float sl  = na
var float tp  = na
var float tp1 = na
var int   side = 0
var bool  partDone = false
bool entered = false

allowL = tradeDir != "Short only"
allowS = tradeDir != "Long only"
bool goL = longSig  and allowL and side != 1  and not na(slLongPrice)  and close - slLongPrice > 0
bool goS = shortSig and allowS and side != -1 and not na(slShortPrice) and slShortPrice - close > 0
if goL and goS
    goS := false

// signal-based exits
if side == 1 and exitLongSig and not goS
    strategy.close("Long", comment=exitTag)
    side := 0
if side == -1 and exitShortSig and not goL
    strategy.close("Short", comment=exitTag)
    side := 0

// entries
if goL
    float d = close - slLongPrice
    ep  := close
    sl  := slLongPrice
    tp  := noTP ? na : na(tpLongPrice) ? close + d * rr : tpLongPrice > close ? tpLongPrice : na
    tp1 := close + d
    partDone := false
    side := 1
    entered := true
    strategy.cancel("S-TP1")
    strategy.cancel("S-Exit")
    strategy.entry("Long", strategy.long, qty=calcQty(d), comment=entryTagL)
    alert(syminfo.ticker + " BUY @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)
else if goS
    float d = slShortPrice - close
    ep  := close
    sl  := slShortPrice
    tp  := noTP ? na : na(tpShortPrice) ? close - d * rr : tpShortPrice < close ? tpShortPrice : na
    tp1 := close - d
    partDone := false
    side := -1
    entered := true
    strategy.cancel("L-TP1")
    strategy.cancel("L-Exit")
    strategy.entry("Short", strategy.short, qty=calcQty(d), comment=entryTagS)
    alert(syminfo.ticker + " SELL @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)

if not entered and strategy.position_size == 0 and side != 0 and not na(strategy.position_size[1])
    side := 0

// management
if side == 1 and not entered
    if usePart and not partDone and (na(tp) or tp1 < tp) and high >= tp1
        partDone := true
    if useBE and partDone
        sl := math.max(sl, ep)
    if useTrail
        float t = close - trailAtr * trailMult
        if t < close
            sl := math.max(sl, t)
    if not na(trailLongPrice) and trailLongPrice < close
        sl := math.max(sl, trailLongPrice)
if side == -1 and not entered
    if usePart and not partDone and (na(tp) or tp1 > tp) and low <= tp1
        partDone := true
    if useBE and partDone
        sl := math.min(sl, ep)
    if useTrail
        float t = close + trailAtr * trailMult
        if t > close
            sl := math.min(sl, t)
    if not na(trailShortPrice) and trailShortPrice > close
        sl := math.min(sl, trailShortPrice)

// exit orders
if side == 1
    if usePart and not partDone and (na(tp) or tp1 < tp)
        strategy.exit("L-TP1", "Long", qty_percent=partPct, limit=tp1, stop=sl, comment_profit="TP1", comment_loss="SL")
    strategy.exit("L-Exit", "Long", limit=tp, stop=sl, comment_profit="TP", comment_loss=partDone ? "Stop (BE/trail)" : "SL")
if side == -1
    if usePart and not partDone and (na(tp) or tp1 > tp)
        strategy.exit("S-TP1", "Short", qty_percent=partPct, limit=tp1, stop=sl, comment_profit="TP1", comment_loss="SL")
    strategy.exit("S-Exit", "Short", limit=tp, stop=sl, comment_profit="TP", comment_loss=partDone ? "Stop (BE/trail)" : "SL")

plot(showLvls and side != 0 ? ep : na, "Entry", color=color.new(color.gray, 20), style=plot.style_linebr, force_overlay=true)
plot(showLvls and side != 0 ? sl : na, "Stop loss", color=color.new(color.red, 0), style=plot.style_linebr, force_overlay=true)
plot(showLvls and side != 0 ? tp : na, "Take profit", color=color.new(color.green, 0), style=plot.style_linebr, force_overlay=true)

