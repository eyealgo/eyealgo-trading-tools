//@version=6
strategy("Candlestick Pattern Strategy & Scanner [Eye Algo]", shorttitle="Candle Patterns", overlay=true, max_labels_count=500, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.02, slippage=1, process_orders_on_close=true)

// ═══════════════════════════════════════════════════════════════
//  PATTERNS
// ═══════════════════════════════════════════════════════════════
G_P = "Patterns"
pBullEng = input.bool(true, "Bullish Engulfing", group=G_P)
pBearEng = input.bool(true, "Bearish Engulfing", group=G_P)
pHammer  = input.bool(true, "Hammer", group=G_P)
pStar    = input.bool(true, "Shooting Star", group=G_P)
pDoji    = input.bool(false, "Doji (at swing high / low)", group=G_P)
pMorning = input.bool(true, "Morning Star", group=G_P)
pEvening = input.bool(true, "Evening Star", group=G_P)
wickRatio = input.float(2.0, "Hammer / star: wick ≥ body ×", minval=1.0, step=0.1, group=G_P)
dojiPct   = input.float(10.0, "Doji: body ≤ % of range", minval=1, maxval=50, group=G_P)
swingLen  = input.int(5, "Swing look-back (hammer / star / doji)", minval=2, group=G_P)

G_F = "Filter"
useEma = input.bool(true, "Trade only in EMA direction", group=G_F)
emaLen = input.int(50, "EMA length", minval=1, group=G_F)
closeOpp = input.bool(true, "Close on opposite pattern", group=G_F)

G_SL = "Stop loss"
slType   = input.string("Pattern high / low", "Stop loss type", options=["Pattern high / low", "ATR", "Fixed ticks"], group=G_SL)
slBufTk  = input.int(5, "Buffer beyond pattern (ticks)", minval=0, group=G_SL)
slAtrLen = input.int(14, "ATR length", minval=1, group=G_SL)
slAtrMul = input.float(1.5, "ATR multiplier", minval=0.1, step=0.1, group=G_SL)
slTicks  = input.int(300, "Fixed stop (ticks)", minval=1, group=G_SL)

G_V = "Visuals"
showLbl  = input.bool(true, "Show pattern labels", group=G_V)
showScan = input.bool(true, "Show scanner panel", group=G_V)

// ═══════════════════════════════════════════════════════════════
//  DETECTION
// ═══════════════════════════════════════════════════════════════
body    = math.abs(close - open)
rng     = high - low
upWick  = high - math.max(open, close)
dnWick  = math.min(open, close) - low
avgBody = ta.sma(body, 14)
bull    = close > open
bear    = close < open
swingLo = low <= ta.lowest(low, swingLen)
swingHi = high >= ta.highest(high, swingLen)
bodyMin = math.max(body, rng * 0.05)

isBullEng = pBullEng and bear[1] and bull and close >= open[1] and open <= close[1] and body > body[1]
isBearEng = pBearEng and bull[1] and bear and close <= open[1] and open >= close[1] and body > body[1]
isHammer  = pHammer and rng > 0 and dnWick >= wickRatio * bodyMin and upWick <= bodyMin and swingLo
isStar    = pStar and rng > 0 and upWick >= wickRatio * bodyMin and dnWick <= bodyMin and swingHi
isDoji    = pDoji and rng > 0 and body <= rng * dojiPct / 100
dojiBull  = isDoji and swingLo
dojiBear  = isDoji and swingHi and not swingLo
isMorning = pMorning and bear[2] and body[2] > avgBody[2] and body[1] < body[2] * 0.3 and bull and close > (open[2] + close[2]) / 2
isEvening = pEvening and bull[2] and body[2] > avgBody[2] and body[1] < body[2] * 0.3 and bear and close < (open[2] + close[2]) / 2

bullPat = isBullEng or isHammer or dojiBull or isMorning
bearPat = isBearEng or isStar or dojiBear or isEvening

patName(bool be, bool hm, bool dj, bool ms) =>
    be ? "Bull Engulfing" : ms ? "Morning Star" : hm ? "Hammer" : dj ? "Doji" : ""
bullName = patName(isBullEng, isHammer, dojiBull, isMorning)
bearName = isBearEng ? "Bear Engulfing" : isEvening ? "Evening Star" : isStar ? "Shooting Star" : dojiBear ? "Doji" : ""

ema = ta.ema(close, emaLen)
plot(useEma ? ema : na, "EMA", color=color.new(#c9ced6, 30))
longOk  = not useEma or close > ema
shortOk = not useEma or close < ema

if showLbl and bullPat
    label.new(bar_index, low, bullName, style=label.style_label_up, color=longOk ? color.new(#22b07d, 0) : color.new(color.gray, 30), textcolor=color.white, size=size.tiny, yloc=yloc.belowbar)
if showLbl and bearPat
    label.new(bar_index, high, bearName, style=label.style_label_down, color=shortOk ? color.new(#e5484d, 0) : color.new(color.gray, 30), textcolor=color.white, size=size.tiny, yloc=yloc.abovebar)
if bullPat
    alert(syminfo.ticker + " " + timeframe.period + ": " + bullName, alert.freq_once_per_bar_close)
if bearPat
    alert(syminfo.ticker + " " + timeframe.period + ": " + bearName, alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════
//  HOOKS FOR THE TRADE ENGINE
// ═══════════════════════════════════════════════════════════════
slAtr = ta.atr(slAtrLen)
patLow  = isMorning ? math.min(low, low[1], low[2]) : isBullEng ? math.min(low, low[1]) : low
patHigh = isEvening ? math.max(high, high[1], high[2]) : isBearEng ? math.max(high, high[1]) : high
longSig      = bullPat and longOk
shortSig     = bearPat and shortOk
exitLongSig  = closeOpp and bearPat
exitShortSig = closeOpp and bullPat
exitTag      = "Opposite pattern"
float slLongPrice  = slType == "Pattern high / low" ? patLow - slBufTk * syminfo.mintick : slType == "ATR" ? close - slAtr * slAtrMul : close - slTicks * syminfo.mintick
float slShortPrice = slType == "Pattern high / low" ? patHigh + slBufTk * syminfo.mintick : slType == "ATR" ? close + slAtr * slAtrMul : close + slTicks * syminfo.mintick
float tpLongPrice  = na
float tpShortPrice = na
bool  noTP         = false
entryTagL = bullName
entryTagS = bearName
float trailLongPrice  = na
float trailShortPrice = na

// ═══════════════════════════════════════════════════════════════
//  TRADE MANAGEMENT  (shared Eye Algo engine)
// ═══════════════════════════════════════════════════════════════
G_TM = "Trade management"
tradeDir  = input.string("Both", "Trade direction", options=["Both", "Long only", "Short only"], group=G_TM)
rr        = input.float(2.0, "Take profit (Risk:Reward)", minval=0.1, step=0.1, group=G_TM)
usePart   = input.bool(true, "Partial close at 1R", group=G_TM)
partPct   = input.int(50, "Partial close (%)", minval=1, maxval=99, group=G_TM)
useBE     = input.bool(true, "Move stop to break-even after partial", group=G_TM)
useTrail  = input.bool(false, "ATR trailing stop", group=G_TM)
trailLen  = input.int(14, "Trailing ATR length", minval=1, group=G_TM)
trailMult = input.float(2.0, "Trailing ATR multiplier", minval=0.1, step=0.1, group=G_TM)

G_PS = "Position size"
sizeMode  = input.string("Fixed quantity", "Size mode", options=["Fixed quantity", "% risk of equity"], group=G_PS)
fixedQty  = input.float(1.0, "Fixed quantity", minval=0.000001, group=G_PS)
riskPct   = input.float(1.0, "Risk per trade (%)", minval=0.01, step=0.1, group=G_PS)

G_VIS = "Visuals"
showLvls  = input.bool(true, "Show entry / SL / TP lines", group=G_VIS)

trailAtr = ta.atr(trailLen)

calcQty(float dist) =>
    float q = sizeMode == "Fixed quantity" or dist <= 0 ? fixedQty : strategy.equity * riskPct / 100.0 / (dist * syminfo.pointvalue)
    math.max(q, 0.0)

var float ep  = na
var float sl  = na
var float tp  = na
var float tp1 = na
var int   side = 0
var bool  partDone = false
bool entered = false

allowL = tradeDir != "Short only"
allowS = tradeDir != "Long only"
bool goL = longSig  and allowL and side != 1  and not na(slLongPrice)  and close - slLongPrice > 0
bool goS = shortSig and allowS and side != -1 and not na(slShortPrice) and slShortPrice - close > 0
if goL and goS
    goS := false

// signal-based exits
if side == 1 and exitLongSig and not goS
    strategy.close("Long", comment=exitTag)
    side := 0
if side == -1 and exitShortSig and not goL
    strategy.close("Short", comment=exitTag)
    side := 0

// entries
if goL
    float d = close - slLongPrice
    ep  := close
    sl  := slLongPrice
    tp  := noTP ? na : na(tpLongPrice) ? close + d * rr : tpLongPrice > close ? tpLongPrice : na
    tp1 := close + d
    partDone := false
    side := 1
    entered := true
    strategy.cancel("S-TP1")
    strategy.cancel("S-Exit")
    strategy.entry("Long", strategy.long, qty=calcQty(d), comment=entryTagL)
    alert(syminfo.ticker + " BUY @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)
else if goS
    float d = slShortPrice - close
    ep  := close
    sl  := slShortPrice
    tp  := noTP ? na : na(tpShortPrice) ? close - d * rr : tpShortPrice < close ? tpShortPrice : na
    tp1 := close - d
    partDone := false
    side := -1
    entered := true
    strategy.cancel("L-TP1")
    strategy.cancel("L-Exit")
    strategy.entry("Short", strategy.short, qty=calcQty(d), comment=entryTagS)
    alert(syminfo.ticker + " SELL @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(sl, format.mintick), alert.freq_once_per_bar_close)

if not entered and strategy.position_size == 0 and side != 0 and not na(strategy.position_size[1])
    side := 0

// management
if side == 1 and not entered
    if usePart and not partDone and (na(tp) or tp1 < tp) and high >= tp1
        partDone := true
    if useBE and partDone
        sl := math.max(sl, ep)
    if useTrail
        float t = close - trailAtr * trailMult
        if t < close
            sl := math.max(sl, t)
    if not na(trailLongPrice) and trailLongPrice < close
        sl := math.max(sl, trailLongPrice)
if side == -1 and not entered
    if usePart and not partDone and (na(tp) or tp1 > tp) and low <= tp1
        partDone := true
    if useBE and partDone
        sl := math.min(sl, ep)
    if useTrail
        float t = close + trailAtr * trailMult
        if t > close
            sl := math.min(sl, t)
    if not na(trailShortPrice) and trailShortPrice > close
        sl := math.min(sl, trailShortPrice)

// exit orders
if side == 1
    if usePart and not partDone and (na(tp) or tp1 < tp)
        strategy.exit("L-TP1", "Long", qty_percent=partPct, limit=tp1, stop=sl, comment_profit="TP1", comment_loss="SL")
    strategy.exit("L-Exit", "Long", limit=tp, stop=sl, comment_profit="TP", comment_loss=partDone ? "Stop (BE/trail)" : "SL")
if side == -1
    if usePart and not partDone and (na(tp) or tp1 > tp)
        strategy.exit("S-TP1", "Short", qty_percent=partPct, limit=tp1, stop=sl, comment_profit="TP1", comment_loss="SL")
    strategy.exit("S-Exit", "Short", limit=tp, stop=sl, comment_profit="TP", comment_loss=partDone ? "Stop (BE/trail)" : "SL")

plot(showLvls and side != 0 ? ep : na, "Entry", color=color.new(color.gray, 20), style=plot.style_linebr, force_overlay=true)
plot(showLvls and side != 0 ? sl : na, "Stop loss", color=color.new(color.red, 0), style=plot.style_linebr, force_overlay=true)
plot(showLvls and side != 0 ? tp : na, "Take profit", color=color.new(color.green, 0), style=plot.style_linebr, force_overlay=true)


// ═══════════════════════════════════════════════════════════════
//  SCANNER PANEL
// ═══════════════════════════════════════════════════════════════
var array<int> cnt  = array.new_int(7, 0)
var array<int> last = array.new_int(7, na)
flags = array.from(isBullEng, isBearEng, isHammer, isStar, isDoji, isMorning, isEvening)
for i = 0 to 6
    if array.get(flags, i)
        array.set(cnt, i, array.get(cnt, i) + 1)
        array.set(last, i, bar_index)

var table scan = table.new(position.top_right, 3, 9, bgcolor=color.new(#0f1115, 10), border_color=color.new(#2a2f38, 0), border_width=1)
if showScan and barstate.islast
    names = array.from("Bull Engulfing", "Bear Engulfing", "Hammer", "Shooting Star", "Doji", "Morning Star", "Evening Star")
    ons   = array.from(pBullEng, pBearEng, pHammer, pStar, pDoji, pMorning, pEvening)
    txt = color.new(#e6e8eb, 0)
    table.cell(scan, 0, 0, "Pattern", text_color=txt, text_size=size.small)
    table.cell(scan, 1, 0, "Count", text_color=txt, text_size=size.small)
    table.cell(scan, 2, 0, "Bars ago", text_color=txt, text_size=size.small)
    for i = 0 to 6
        bool isBull = i == 0 or i == 2 or i == 5
        color c = not array.get(ons, i) ? color.gray : i == 4 ? color.new(#f0883e, 0) : isBull ? color.new(#22b07d, 0) : color.new(#e5484d, 0)
        int l = array.get(last, i)
        table.cell(scan, 0, i + 1, array.get(names, i), text_color=c, text_size=size.small)
        table.cell(scan, 1, i + 1, array.get(ons, i) ? str.tostring(array.get(cnt, i)) : "off", text_color=txt, text_size=size.small)
        table.cell(scan, 2, i + 1, na(l) ? "-" : str.tostring(bar_index - l), text_color=txt, text_size=size.small)
    table.cell(scan, 0, 8, "Trend (EMA " + str.tostring(emaLen) + ")", text_color=txt, text_size=size.small)
    table.cell(scan, 1, 8, close > ema ? "UP" : "DOWN", text_color=close > ema ? color.new(#22b07d, 0) : color.new(#e5484d, 0), text_size=size.small)
    table.cell(scan, 2, 8, "", text_size=size.small)
